FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# System dependencies for data science libraries
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY shared/requirements-base.txt ./shared-reqs.txt
COPY archiver/requirements.txt ./archiver-reqs.txt

# Install dependencies (Pandas/PyArrow are installed here)
RUN pip install --no-cache-dir -r archiver-reqs.txt

# Copy shared logic and the archiver script
COPY shared/ ./shared/
COPY archiver/ ./archiver/

# Execute and exit
CMD ["python", "archiver/main.py"]