FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# 1. Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 2. Setup directory structure for requirements
RUN mkdir -p shared archiver

COPY shared/requirements-base.txt ./shared/requirements-base.txt
COPY archiver/requirements.txt ./archiver/requirements.txt

# 3. Install dependencies
RUN pip install --no-cache-dir -r archiver/requirements.txt

# 4. Copy source code 
COPY shared/ ./shared/
COPY archiver/ ./archiver/

# Execute
CMD ["python", "archiver/main.py"]