# Use a slim version of Python to reduce image size
FROM python:3.11-slim

# Set the working directory
WORKDIR /app

# Prevent Python from writing .pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Install system dependencies for psycopg2 (Postgres driver)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements from their specific folders
COPY shared/requirements-base.txt ./shared-reqs.txt
COPY api/requirements.txt ./api-reqs.txt

# Install dependencies
RUN pip install --no-cache-dir -r api-reqs.txt

# Copy ONLY the necessary code (Least Privilege)
COPY shared/ ./shared/
COPY api/ ./api/

# Expose the FastAPI port
EXPOSE 8080

# Start the web server
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]