# 1. Base Stage: Use a slim image for production-grade sizing
FROM python:3.11-slim

# 2. Set the working directory to the root of our app context
WORKDIR /app

# 3. Environment Variables for Python stability
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# 4. Install system-level dependencies for the Postgres driver
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 5. Mirror exact directory structure
COPY shared/requirements-base.txt ./shared/requirements-base.txt
COPY api/requirements.txt ./api/requirements.txt

# 6. Execute pip install from the specific subdirectory
WORKDIR /app/api
RUN pip install --no-cache-dir -r requirements.txt

# 7. Finalize the application code
WORKDIR /app
COPY shared/ ./shared/
COPY api/ ./api/

# 8. Container Metadata and Startup
EXPOSE 8080

# 9. Full module path used for uvicorn because PYTHONPATH is set to /app
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]